# Contact form: any endpoint that accepts a JSON POST (Formspree, Web3Forms, ...).
# Until this is set, "Send message" opens the visitor's email app addressed to the public email.
NEXT_PUBLIC_FORM_ENDPOINT=
# Web3Forms only: the public access key (leave empty for Formspree)
NEXT_PUBLIC_WEB3FORMS_KEY=

# Optional overrides. GitHub, LinkedIn and the public email already default to the real ones
# in content/site.ts; only set these to change them. X is hidden until you add one.
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_EMAIL=
